{
  "name": "k-player",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "kanzas-progger",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "overrides": {
    "node-gyp": "^12.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "k-player",
    "productName": "K-PLayer",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "db/**/*",
      "ipc/**/*",
      "constants/**/*",
      "services/**/*",
      "protocols/**/*",
      "helpers/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false,
      "shortcutName": "K-Player"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Audio",
      "icon": "assets/logo.png"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "music-metadata": "^11.15.0"
  }
}